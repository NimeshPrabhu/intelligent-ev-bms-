# ================= Operational Mode =================
# Set to False when physical ESP2/LoRa/USB Serial is connected to the Pi/PC
USE_SIMULATED_HARDWARE=True

# ================= Battery Pack Specifications =================
# Configure for your battery pack (e.g. 3S 11.1V / 2.5Ah or 48V / 20Ah)
NOMINAL_PACK_VOLTAGE=11.1
SERIES_CELLS=3
PARALLEL_CELLS=1
BATTERY_CAPACITY_AH=2.5
NOMINAL_EFFICIENCY_WH_KM=22.0

# ================= Safety & Fault Cutoff Thresholds =================
VOLTAGE_OVERVOLT_CRITICAL=12.65
VOLTAGE_OVERVOLT_WARNING=12.40
VOLTAGE_UNDERVOLT_WARNING=9.90
VOLTAGE_UNDERVOLT_CRITICAL=9.00

CURRENT_DISCHARGE_WARN=5.0
CURRENT_DISCHARGE_CRIT=7.5
CURRENT_CHARGE_WARN=-2.5
CURRENT_CHARGE_CRIT=-3.5

TEMP_OVERTEMP_CRITICAL=55.0
TEMP_OVERTEMP_WARNING=45.0
TEMP_UNDERTEMP_WARNING=0.0

# Anti-chatter Debounce & Recovery Timing (seconds)
FAULT_TRIP_DEBOUNCE_S=0.3
FAULT_RECOVERY_DEBOUNCE_S=2.0
STALE_DATA_TIMEOUT_S=3.0

# ================= Serial & Hardware Link =================
# Set to specific port e.g. /dev/ttyUSB0 (Linux/Pi) or COM3 (Windows), or leave blank for auto-detect
SERIAL_PORT=
SERIAL_BAUDRATE=115200
LORA_FREQ=433.0

# ================= Security & Remote Relay Control =================
ADMIN_API_KEY=bms-secret-key-2026
